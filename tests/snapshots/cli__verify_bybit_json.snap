  "findings": [
    {
      "id": "BS-DELEGATE-001",
      "severity": "critical",
      "title": "Delegatecall to a contract that is not an official Safe helper",
      "detail": "This call runs the code at 0x96221423681A6d52E184D440a8eFCEbB105C7242 with the storage of 0x1Db92e2EeBC8E0c075a02BeA49a2935BcD2dFCF4 (this Safe). That code can replace the owners, threshold, modules, guard, fallback handler and the implementation pointer in storage slot 0, after which the attacker no longer needs any signature. This is how the Bybit (2025) and WazirX (2024) Safes were taken over. Do not sign unless you have reviewed the target's source and know why it needs delegatecall.",
      "path": "root"
    },
    {
      "id": "BS-SEMANTICS-001",
      "severity": "critical",
      "title": "\"transfer\" is a guess from the selector, not a verified function",
      "detail": "The calldata matches transfer(address,uint256), but 0x96221423681A6d52E184D440a8eFCEbB105C7242 is not known to implement it: under delegatecall a token function moves no tokens: the target's code runs on the Safe's own storage. Any contract can give a function this signature and do something else; the Bybit attack used transfer(address,uint256), executed by delegatecall, to replace the Safe's implementation. Treat the decoded name and arguments as a layout, not as a description.",
      "path": "root"
    },
    {
      "id": "BS-REPLAY-001",
      "severity": "low",
      "title": "Signature valid on every chain",
      "detail": "Safe 1.1.1 has no chain id in its signing domain, so this signature is also valid on any other chain where a Safe exists at 0x1Db92e2EeBC8E0c075a02BeA49a2935BcD2dFCF4 with the same nonce. Make sure no such Safe exists, or that it is under the same control.",
      "path": "root"
    },
    {
      "id": "BS-TARGET-001",
      "severity": "info",
      "title": "Unknown target",
      "detail": "0x96221423681A6d52E184D440a8eFCEbB105C7242 is not an official Safe contract, a listed token or an address-book entry. Check it against a source you trust (add it to your address book to label it).",
      "path": "root"
    }
